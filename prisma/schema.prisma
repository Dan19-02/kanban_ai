// Prisma schema for Meeting to Kanban AI
// Database: PostgreSQL
// Run `npm run db:generate` after editing, and `npm run db:migrate` to apply changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Role a member holds on a board. The board owner is tracked separately via
/// Board.ownerId and implicitly has full control.
enum Role {
  EDITOR
  VIEWER
}

/// Subscription tier. Determines the transcription (AI analysis) quota.
///   FREE      → 3 transcriptions, lifetime
///   STARTER   → 30 / month   ($10)
///   PRO       → 100 / month  ($30)
///   UNLIMITED → unlimited    ($99)
enum Plan {
  FREE
  STARTER
  PRO
  UNLIMITED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Billing & usage ---
  plan Plan @default(FREE)
  // Lifetime count of transcriptions used on the FREE plan (capped at 3).
  freeTranscriptionsUsed Int @default(0)
  // Transcriptions used in the current paid billing period (reset on renewal).
  periodTranscriptionsUsed Int @default(0)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?

  ownedBoards Board[]       @relation("BoardOwner")
  memberships BoardMember[]
  comments    Comment[]
}

model Board {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // --- AI analysis output (populated after a transcript is analyzed) ---
  transcript         String? @db.Text
  summary            String? @db.Text
  keyDecisions       String[]
  risks              String[]
  dependencies       String[]
  blockers           String[]
  openQuestions      String[]
  sentimentScore     String?
  sentimentBreakdown String? @db.Text

  // --- Shareable link ---
  // When shareToken is null, link sharing is disabled. shareRole is the role
  // granted to a logged-in user who opens the link.
  shareToken String? @unique
  shareRole  Role?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     BoardMember[]
  actionItems ActionItem[]
  comments    Comment[]

  @@index([ownerId])
}

model BoardMember {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role   @default(EDITOR)
  // The name this member chose to display on this board. Set when they join;
  // falls back to the account name until then.
  displayName String?
  createdAt   DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model ActionItem {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  assignee    String   @default("Unassigned")
  description String?  @db.Text
  status      String   @default("pending") // "pending" | "completed"
  priority    String? // "High" | "Medium" | "Low"
  dueDate     String? // ISO date string (yyyy-mm-dd), kept as text to match UI
  // Titles of other action items on this board that must finish first.
  blockedBy   String[]
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId])
}

model Comment {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String // denormalized so comments survive author deletion
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([boardId])
}
