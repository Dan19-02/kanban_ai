// Prisma schema for Meeting to Kanban AI
// Database: PostgreSQL
// Run `npm run db:generate` after editing, and `npm run db:migrate` to apply changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Role a member holds on a board. The board owner is tracked separately via
/// Board.ownerId and implicitly has full control.
enum Role {
  EDITOR
  VIEWER
}

/// Subscription tier. Determines the transcription (AI analysis) quota.
///   FREE      → 3 transcriptions, lifetime
///   STARTER   → 30 / month   ($10)
///   PRO       → 100 / month  ($30)
///   UNLIMITED → unlimited    ($99)
enum Plan {
  FREE
  STARTER
  PRO
  UNLIMITED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Billing & usage ---
  plan Plan @default(FREE)
  // Lifetime count of transcriptions used on the FREE plan (capped at 3).
  freeTranscriptionsUsed Int @default(0)
  // Transcriptions used in the current paid billing period (reset on renewal).
  periodTranscriptionsUsed Int @default(0)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?

  ownedBoards        Board[]         @relation("BoardOwner")
  ownedProjects      Project[]       @relation("ProjectOwner")
  memberships        BoardMember[]
  projectMemberships ProjectMember[]
  comments           Comment[]
  notifications      Notification[]
}

/// An in-app notification for a user — created when they're @mentioned in a
/// comment or assigned a task. `read` flips when they open the inbox.
model Notification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // "mention" | "assignment"
  // Where it points (board to open). actionItemId is informational (no FK, so
  // deleting an item doesn't need to cascade here).
  boardId      String?
  board        Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actionItemId String?
  actorName    String // who triggered it (display name)
  text         String   @db.Text // preview snippet
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// A workspace that groups related boards (e.g. one project = a client or
/// initiative; each board inside = a meeting / call / day). Owner-scoped: the
/// owner is the admin who tracks the work. Collaboration stays per-board via
/// BoardMember, so a project never widens access on its own.
model Project {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  /// Display colour token from a fixed allow-list (see validation.ts), not raw
  /// CSS — the frontend maps it to a Tailwind class.
  color       String  @default("indigo")
  ownerId     String
  owner       User    @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  archived    Boolean @default(false)

  // --- Shareable link (mirrors Board). A logged-in user opening the link gets
  // shareRole on the project and, by inheritance, on all its boards. ---
  shareToken String? @unique
  shareRole  Role?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boards  Board[]
  members ProjectMember[]

  @@index([ownerId])
}

model Board {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Owning project (optional: legacy boards and link-shared boards may be
  // unfiled). SetNull so deleting a project never destroys its boards.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // --- AI analysis output (populated after a transcript is analyzed) ---
  transcript         String? @db.Text
  summary            String? @db.Text
  keyDecisions       String[]
  risks              String[]
  dependencies       String[]
  blockers           String[]
  openQuestions      String[]
  sentimentScore     String?
  sentimentBreakdown String? @db.Text

  // --- Shareable link ---
  // When shareToken is null, link sharing is disabled. shareRole is the role
  // granted to a logged-in user who opens the link.
  shareToken String? @unique
  shareRole  Role?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       BoardMember[]
  actionItems   ActionItem[]
  comments      Comment[]
  notifications Notification[]

  @@index([ownerId])
  @@index([projectId])
}

model BoardMember {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role   @default(EDITOR)
  // The name this member chose to display on this board. Set when they join;
  // falls back to the account name until then.
  displayName String?
  createdAt   DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

/// A user granted access to a whole project (and, by inheritance, every board in
/// it). Mirrors BoardMember. The project owner is tracked via Project.ownerId.
model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @default(EDITOR)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ActionItem {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  assignee    String   @default("Unassigned")
  description String?  @db.Text
  status      String   @default("pending") // "pending" | "completed"
  priority    String? // "High" | "Medium" | "Low"
  dueDate     String? // ISO date string (yyyy-mm-dd), kept as text to match UI
  // Titles of other action items on this board that must finish first.
  blockedBy   String[]
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments Comment[]

  @@index([boardId])
}

model Comment {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // When set, this is a task-level comment (the board-level chat uses
  // actionItemId = null). Cascade so a task's discussion is removed with it.
  actionItemId String?
  actionItem   ActionItem? @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String // denormalized so comments survive author deletion
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([boardId])
  @@index([actionItemId])
}
