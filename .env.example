# ─── Required ───────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kanban_ai"

# Secret for signing auth JWTs (min 32 chars). Generate with:
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"

# ─── Optional ───────────────────────────────────────────────────────────────
# Server port (default: 3000)
PORT=3000

# NVIDIA API key for MiniMax M3 (AI transcript analysis)
# NVIDIA_API_KEY=

# Public URL of the deployed app (used for CORS & share links)
# APP_URL=https://your-app.onrender.com

# ─── Stripe (optional; billing works without these) ─────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_UNLIMITED=
