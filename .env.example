# Copy to .env and fill in the values:  cp .env.example .env

# ─── Required ───────────────────────────────────────────────────────────────
# Postgres connection string. The default matches the bundled docker-compose.yml.
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# Secret for signing auth JWTs (min 32 chars). Generate with:
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"

# ─── Optional ───────────────────────────────────────────────────────────────
# Environment: development | production | test  (default: development)
NODE_ENV="development"

# Port the server listens on (default: 3000). On Render this is injected
# automatically — do not hard-code it there.
PORT=3000

# NVIDIA API key for MiniMax M3 (AI transcript analysis). Leave blank to run
# the app without AI analysis (the analyze endpoint returns a clear error).
NVIDIA_API_KEY=""

# ─── Two-service deployment (frontend + backend on different origins) ────────
# Public URL of the FRONTEND. Required in production: it locks down CORS,
# builds share links, and sets Stripe redirect URLs.
# APP_URL="https://kanban-ai-frontend.onrender.com"

# Optional. Set to a shared parent domain when frontend and backend run on
# sibling subdomains (e.g. app/api of yourdomain.com) so the auth cookie is
# first-party. Leave unset on the default *.onrender.com domains.
# COOKIE_DOMAIN=".yourdomain.com"

# ─── Stripe (optional; billing works without these) ─────────────────────────
# Webhook endpoint:  {backend-url}/api/billing/webhook
# Locally:  stripe listen --forward-to localhost:3000/api/billing/webhook
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_STARTER=""
# STRIPE_PRICE_PRO=""
# STRIPE_PRICE_UNLIMITED=""
